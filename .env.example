# =============================================================================
# Real Estate Aggregator — Environment Template
# Скопируйте в .env и заполните значения: cp .env.example .env
# =============================================================================

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- CORS (frontend) ---
CORS_ORIGINS=http://localhost:3000

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- PostgreSQL (локально; для Docker раскомментируйте docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Auth service DB
AUTH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auth_db

# Listing service DB
LISTING_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/listing_db

# Messaging service DB
MESSAGING_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/messaging_db

# Analytics service DB
ANALYTICS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/analytics_db

# --- Uploads (MVP local storage) ---
UPLOAD_DIR=./uploads

# --- Service ports (local Start_test.py) ---
AUTH_SERVICE_PORT=8001
LISTING_SERVICE_PORT=8002
SEARCH_SERVICE_PORT=8003
MESSAGING_SERVICE_PORT=8004
ANALYTICS_SERVICE_PORT=8005
NOTIFICATION_SERVICE_PORT=8006

# --- Logging ---
LOG_LEVEL=INFO

# --- Geocoding (Nominatim) ---
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=real-estate-aggregator/1.0
