# Copy to .env locally and replace every placeholder before starting Compose.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
GATEWAY_SHARED_SECRET=replace-with-another-random-secret
MODERATION_SHARED_SECRET=replace-with-a-moderation-to-listing-secret
REFRESH_COOKIE_SECURE=true
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=replace-with-a-random-rabbitmq-password
RABBITMQ_URL_DOCKER=amqp://app:replace-with-a-random-rabbitmq-password@rabbitmq:5672/
REDIS_URL_DOCKER=redis://redis:6379/0
HTTP_PORT=8080
AUTH_RATE_LIMIT_PER_MINUTE=30
MONGO_PORT=27017
RABBITMQ_UI_PORT=15672
AUTH_SERVICE_URL=http://auth-service:8000
LISTING_SERVICE_URL=http://listing-service:8000
SEARCH_SERVICE_URL=http://search-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000
MESSAGING_SERVICE_URL=http://messaging-service:8000
MODERATION_SERVICE_URL=http://moderation-service:8000
# Auth email verification (Gmail personal SMTP example; replace with provider credentials).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=paste-app-password-without-spaces
SMTP_FROM_ADDRESS=your-address@gmail.com
SMTP_START_TLS=true
# AI keys and model settings live only in analytic-ai/.env (not in the root .env).
# Service-to-service URLs below use Docker DNS by default. Set reachable hostnames/IPs when split across machines.
AUTH_DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:change-this-password@postgres:5432/auth_db
LISTING_DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:change-this-password@postgres:5432/listing_db
ANALYTIC_AI_DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:change-this-password@postgres:5432/analytic_ai_db
MODERATION_DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:change-this-password@postgres:5432/moderation_db
SEARCH_MONGODB_URL_DOCKER=mongodb://mongo:27017/search_catalog
ANALYTIC_SCRIPTS_MONGODB_URL_DOCKER=mongodb://mongo:27017/analytic_scripts_db
PARSERS_MONGODB_URL_DOCKER=mongodb://mongo:27017/parsers_db
MESSAGING_MONGODB_URL_DOCKER=mongodb://mongo:27017/messaging_db
NOTIFICATION_MONGODB_URL_DOCKER=mongodb://mongo:27017/notification_db
