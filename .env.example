# Copy to .env locally and replace every placeholder before starting Compose.
JWT_PRIVATE_KEY_B64=replace-with-generated-base64-rsa-private-key
JWT_PUBLIC_KEY_B64=replace-with-generated-base64-rsa-public-key
JWT_ALGORITHM=RS256
REFRESH_COOKIE_SECURE=true
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-postgres-admin-password
AUTH_DB_PASSWORD=replace-with-a-unique-random-password
LISTING_DB_PASSWORD=replace-with-a-unique-random-password
MODERATION_DB_PASSWORD=replace-with-a-unique-random-password
ANALYTIC_AI_DB_PASSWORD=replace-with-a-unique-random-password
AUTH_GATEWAY_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
LISTING_GATEWAY_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
SEARCH_GATEWAY_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
MODERATION_GATEWAY_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
MESSAGING_GATEWAY_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
NOTIFICATION_GATEWAY_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
AUTH_MODERATION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
LISTING_MODERATION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
MONGO_ROOT_USERNAME=miero_admin
MONGO_ROOT_PASSWORD=replace-with-a-strong-mongodb-admin-password
SEARCH_MONGO_PASSWORD=replace-with-a-unique-random-password
ANALYTIC_SCRIPTS_MONGO_PASSWORD=replace-with-a-unique-random-password
PARSERS_MONGO_PASSWORD=replace-with-a-unique-random-password
MESSAGING_MONGO_PASSWORD=replace-with-a-unique-random-password
NOTIFICATION_MONGO_PASSWORD=replace-with-a-unique-random-password
GATEWAY_REDIS_PASSWORD=replace-with-a-unique-random-password
AUTH_REDIS_PASSWORD=replace-with-a-unique-random-password
SEARCH_REDIS_PASSWORD=replace-with-a-unique-random-password
ANALYTIC_AI_REDIS_PASSWORD=replace-with-a-unique-random-password
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=replace-with-a-random-rabbitmq-password
RABBITMQ_URL_DOCKER=amqp://app:replace-with-a-random-rabbitmq-password@rabbitmq:5672/
HTTP_PORT=8080
AUTH_RATE_LIMIT_PER_MINUTE=15
UPLOAD_RATE_LIMIT_PER_MINUTE=10
MONGO_PORT=27017
RABBITMQ_UI_PORT=15672
AUTH_SERVICE_URL=http://auth-service:8000
LISTING_SERVICE_URL=http://listing-service:8000
SEARCH_SERVICE_URL=http://search-service:8000
NOTIFICATION_SERVICE_URL=http://notification-service:8000
MESSAGING_SERVICE_URL=http://messaging-service:8000
MODERATION_SERVICE_URL=http://moderation-service:8000
# Auth email verification (Gmail personal SMTP example; replace with provider credentials).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=paste-app-password-without-spaces
SMTP_FROM_ADDRESS=your-address@gmail.com
SMTP_START_TLS=true
# AI keys and model settings live only in analytic-ai/.env (not in the root .env).
# In Docker Compose each app gets a dedicated database role and authenticated Redis/Mongo account.
# For Kubernetes/external providers, set each service's URL directly and use TLS-enabled schemes.
