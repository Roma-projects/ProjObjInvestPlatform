DATABASE_URL=postgresql+asyncpg://analytic_ai_app:replace-with-analytic-ai-db-password@postgres:5432/analytic_ai_db
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_MODEL=google/gemini-3.8-flash
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=Qwen2.5-VL-7B-Instruct
MODEL_TIMEOUT_SECONDS=90
REGISTRY_WAIT_TIMEOUT_SECONDS=420
PUBLIC_UPLOAD_DIR=/public_uploads
