DATABASE_URL=postgresql+asyncpg://auth_app:replace-with-auth-db-password@postgres:5432/auth_db
JWT_PRIVATE_KEY_B64=replace-with-generated-base64-rsa-private-key
JWT_PUBLIC_KEY_B64=replace-with-generated-base64-rsa-public-key
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
REDIS_URL=redis://auth:replace-with-auth-redis-password@redis:6379/0
RABBITMQ_URL=amqp://app:change-this-password@rabbitmq:5672/
GATEWAY_SHARED_SECRET=replace-with-auth-gateway-secret-at-least-32-characters
REFRESH_COOKIE_SECURE=true
MODERATION_SERVICE_SHARED_SECRET=replace-with-auth-moderation-secret-at-least-32-characters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=paste-app-password-without-spaces
SMTP_FROM_ADDRESS=your-address@gmail.com
SMTP_START_TLS=true
AVATAR_UPLOAD_DIR=./auth_avatars
