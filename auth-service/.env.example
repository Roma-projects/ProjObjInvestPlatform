DATABASE_URL=postgresql+asyncpg://postgres:change-this-password@postgres:5432/auth_db
JWT_SECRET_KEY=replace-with-the-same-root-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://app:change-this-password@rabbitmq:5672/
GATEWAY_SHARED_SECRET=replace-with-the-same-root-gateway-secret
REFRESH_COOKIE_SECURE=true
MODERATION_SERVICE_SHARED_SECRET=replace-with-the-moderation-service-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=paste-app-password-without-spaces
SMTP_FROM_ADDRESS=your-address@gmail.com
SMTP_START_TLS=true
AVATAR_UPLOAD_DIR=./auth_avatars
