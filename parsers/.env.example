# Use hostnames reachable from this machine (Docker service names or localhost when running locally).
RABBITMQ_URL=amqp://app:change-this-password@rabbitmq:5672/
MONGODB_URL=mongodb://parsers_app:replace-with-parsers-mongo-password@mongo:27017/parsers_db?authSource=parsers_db
PARSERS_STORAGE_DIR=/parsers_storage
REQUEST_TIMEOUT_SECONDS=20
