REDIS_URL=redis://search:replace-with-search-redis-password@redis:6379/0
MONGODB_URL=mongodb://search_app:replace-with-search-mongo-password@mongo:27017/search_catalog?authSource=search_catalog
RABBITMQ_URL=amqp://app:change-this-password@rabbitmq:5672/
GATEWAY_SHARED_SECRET=replace-with-search-gateway-secret-at-least-32-characters

# Nominatim is called only from Search when an approved public listing has no coordinates.
# Use a real, identifiable app name; include a contact address in production if available.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=MieroVenture/1.0
NOMINATIM_ENABLED=true
NOMINATIM_MIN_INTERVAL_MS=1100
